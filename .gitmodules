[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "gsDesign"]
	path = gsDesign
	url = https://github.com/keaven/gsdesign
[submodule "gsDesignNB"]
	path = gsDesignNB
	url = https://github.com/keaven/gsdesignnb
[submodule "lt"]
	path = lt
	url = https://github.com/yihui/lt
	registered = false
